{
  "name": "jansetu-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/i18n && tsc --noEmit -p packages/api && tsc --noEmit -p packages/ui && tsc --noEmit -p apps/workspace && tsc --noEmit -p apps/customer",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build --workspace apps/workspace",
    "dev:workspace": "npm run dev --workspace apps/workspace",
    "dev:customer": "npm run dev --workspace apps/customer",
    "e2e": "npm run e2e --workspace apps/workspace"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  }
}
